{
    "name": "tuxweb/pyroshape-skeleton",
    "description": "Starter application for Pyroshape",
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Dino Ciuffetti",
            "email": "dam2000@gmail.com"
        }
    ],
    "require": {
        "tuxweb-it/pyroshape": "^0.9.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "reference": "config",
                "versions": {
                    "tuxweb-it/pyroshape": "0.9.2"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "TuxWeb\\PyroshapeSkeleton\\": "src/"
        }
    }
}
